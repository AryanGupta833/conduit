{
  "uid": "conduit-overview",
  "title": "Conduit Operations",
  "tags": ["conduit", "operations"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    { "id": 1, "type": "timeseries", "title": "Workflow executions / second", "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "sum by (status) (rate(conduit_workflow_executions_total[5m]))", "legendFormat": "{{status}}", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }, "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } } },
    { "id": 2, "type": "stat", "title": "Active workflows", "gridPos": { "x": 12, "y": 0, "w": 6, "h": 8 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "conduit_workflow_active_executions", "refId": "A" }], "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "colorMode": "value", "graphMode": "area", "textMode": "auto" } },
    { "id": 3, "type": "timeseries", "title": "Task outcomes / second", "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "sum by (plugin_type, status) (rate(conduit_task_executions_total[5m]))", "legendFormat": "{{plugin_type}} {{status}}", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }, "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } } },
    { "id": 4, "type": "timeseries", "title": "Task retry attempts / second", "gridPos": { "x": 12, "y": 8, "w": 6, "h": 8 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "sum by (plugin_type) (rate(conduit_task_retries_total[5m]))", "legendFormat": "{{plugin_type}}", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }, "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } } },
    { "id": 5, "type": "timeseries", "title": "Backend executions / second", "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "sum by (backend, status) (rate(conduit_backend_executions_total[5m]))", "legendFormat": "{{backend}} {{status}}", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }, "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } } },
    { "id": 6, "type": "timeseries", "title": "Workflow duration p95", "gridPos": { "x": 12, "y": 16, "w": 6, "h": 8 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, status) (rate(conduit_workflow_execution_duration_seconds_bucket[5m])))", "legendFormat": "{{status}}", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }, "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } } },
    { "id": 7, "type": "timeseries", "title": "Task duration p95", "gridPos": { "x": 0, "y": 24, "w": 12, "h": 8 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, plugin_type) (rate(conduit_task_execution_duration_seconds_bucket[5m])))", "legendFormat": "{{plugin_type}}", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }, "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } } },
    { "id": 8, "type": "timeseries", "title": "Backend duration p95", "gridPos": { "x": 12, "y": 24, "w": 6, "h": 8 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, backend) (rate(conduit_backend_execution_duration_seconds_bucket[5m])))", "legendFormat": "{{backend}}", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }, "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } } },
    { "id": 9, "type": "stat", "title": "Worker tasks in progress", "gridPos": { "x": 0, "y": 32, "w": 6, "h": 8 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "sum(conduit_worker_active_tasks)", "refId": "A" }], "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "colorMode": "value", "graphMode": "area", "textMode": "auto" } },
    { "id": 10, "type": "timeseries", "title": "Worker processed tasks / second", "gridPos": { "x": 6, "y": 32, "w": 12, "h": 8 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "sum by (status) (rate(conduit_worker_tasks_processed_total[5m]))", "legendFormat": "{{status}}", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }, "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } } },
    { "id": 11, "type": "stat", "title": "Pending delivered messages", "description": "Redis consumer group messages delivered but not acknowledged.", "gridPos": { "x": 0, "y": 40, "w": 6, "h": 8 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "conduit_task_queue_pending", "refId": "A" }], "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "colorMode": "value", "graphMode": "area", "textMode": "auto" } },
    { "id": 12, "type": "stat", "title": "Retained stream entries", "description": "Total Redis stream records; acknowledged records remain retained, so this is not backlog depth.", "gridPos": { "x": 6, "y": 40, "w": 6, "h": 8 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "conduit_task_queue_stream_entries", "refId": "A" }], "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "colorMode": "value", "graphMode": "area", "textMode": "auto" } }
  ]
}
