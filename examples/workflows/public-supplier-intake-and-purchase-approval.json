{
  "schemaVersion": 1,
  "name": "Public Supplier Intake and Purchase Approval",
  "cronExpression": null,
  "tasks": [
    { "name": "initializePurchase", "displayName": "Initialize Purchase Review", "pluginType": "SET_VARIABLES", "configurationJson": "{\"variables\":{\"purchaseCaseId\":\"DEMO-PO-1001\",\"supplier\":\"Books to Scrape Demo Catalog\",\"reviewMailbox\":\"replace-with-review-mailbox@example.com\"}}", "timeoutSeconds": 30, "maxRetries": 0, "joinCondition": "ALL_PARENTS", "xPosition": 80, "yPosition": 300 },
    { "name": "downloadSupplierFeed", "displayName": "Download Public Supplier Feed", "pluginType": "HTTP_DOWNLOAD", "configurationJson": "{\"url\":\"https://jsonplaceholder.typicode.com/posts\",\"path\":\"supplier/posts.json\",\"maxBytes\":1048576,\"overwrite\":true}", "timeoutSeconds": 45, "maxRetries": 2, "joinCondition": "ALL_PARENTS", "xPosition": 340, "yPosition": 120 },
    { "name": "readSupplierFeed", "displayName": "Read Supplier Feed", "pluginType": "FILE_READ", "configurationJson": "{\"workspaceRoot\":\".\",\"path\":\"supplier/posts.json\",\"encoding\":\"UTF-8\"}", "timeoutSeconds": 30, "maxRetries": 0, "joinCondition": "ALL_PARENTS", "xPosition": 600, "yPosition": 120 },
    { "name": "parseSupplierFeed", "displayName": "Validate Supplier Feed JSON", "pluginType": "JSON_TRANSFORM", "configurationJson": "{\"operation\":\"PARSE\",\"input\":\"${tasks.readSupplierFeed.output}\"}", "timeoutSeconds": 30, "maxRetries": 0, "joinCondition": "ALL_PARENTS", "xPosition": 860, "yPosition": 120 },
    { "name": "scrapeSupplierCatalog", "displayName": "Scrape Public Supplier Catalog", "pluginType": "WEB_SCRAPE", "configurationJson": "{\"url\":\"https://books.toscrape.com/catalogue/page-1.html\",\"nextSelector\":\"li.next a\",\"maxPages\":2,\"pageDelayMs\":500,\"itemSelector\":\".product_pod\",\"selectors\":{\"title\":{\"selector\":\"h3 a\",\"attribute\":\"title\"},\"price\":\".price_color\",\"availability\":\".availability\",\"detailUrl\":{\"selector\":\"h3 a\",\"attribute\":\"href\"}},\"maxItems\":40}", "timeoutSeconds": 60, "maxRetries": 1, "joinCondition": "ALL_PARENTS", "xPosition": 340, "yPosition": 360 },
    { "name": "inspectVendorDrop", "displayName": "Inspect Vendor SFTP Drop", "pluginType": "SFTP", "configurationJson": "{\"operation\":\"LIST\",\"host\":\"sftp.partner.example\",\"port\":22,\"username\":\"replace-with-sftp-user\",\"password\":{\"$credential\":\"vendor-sftp-password\"},\"hostKeyFingerprint\":\"SHA256:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\",\"remotePath\":\"/incoming\",\"maxEntries\":100,\"timeoutSeconds\":20,\"allowPrivateNetwork\":false}", "timeoutSeconds": 30, "maxRetries": 1, "joinCondition": "ALL_PARENTS", "xPosition": 600, "yPosition": 560 },
    { "name": "reviewPurchase", "displayName": "Human Purchase Review", "pluginType": "HUMAN_TASK", "configurationJson": "{\"type\":\"APPROVAL\",\"title\":\"Review supplier purchase proposal\",\"description\":\"Compare the parsed public feed, scraped catalog prices, and SFTP incoming-file list. Approve only after checking supplier, price, and available stock.\",\"timeoutSeconds\":86400,\"timeoutPolicy\":\"REJECT\",\"reminderAfterSeconds\":3600}", "timeoutSeconds": 86400, "maxRetries": 0, "joinCondition": "ALL_PARENTS", "xPosition": 1120, "yPosition": 320 },
    { "name": "archiveApprovedFeed", "displayName": "Archive Approved Supplier Feed", "pluginType": "SFTP", "configurationJson": "{\"operation\":\"UPLOAD\",\"host\":\"sftp.partner.example\",\"port\":22,\"username\":\"replace-with-sftp-user\",\"password\":{\"$credential\":\"vendor-sftp-password\"},\"hostKeyFingerprint\":\"SHA256:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\",\"remotePath\":\"/archive/approved/purchase-feed.json\",\"localPath\":\"supplier/posts.json\",\"maxBytes\":10485760,\"timeoutSeconds\":20,\"overwrite\":false,\"allowPrivateNetwork\":false}", "timeoutSeconds": 60, "maxRetries": 2, "joinCondition": "ALL_PARENTS", "xPosition": 1450, "yPosition": 180 },
    { "name": "sendPurchaseNotice", "displayName": "Notify Purchasing Team", "pluginType": "EMAIL_SEND", "configurationJson": "{\"smtpHost\":\"smtp.example.com\",\"smtpPort\":587,\"username\":\"replace-with-smtp-user\",\"password\":{\"$credential\":\"smtp-password\"},\"from\":\"conduit@example.com\",\"to\":[\"replace-with-review-mailbox@example.com\"],\"subject\":\"Supplier purchase review ${variables.purchaseCaseId}\",\"body\":\"Approved supplier feed for ${variables.supplier}. Review execution ${execution.id} before dispatch.\",\"html\":false}", "timeoutSeconds": 45, "maxRetries": 1, "joinCondition": "ALL_PARENTS", "xPosition": 1750, "yPosition": 180 },
    { "name": "writeRejectedNote", "displayName": "Record Rejected Purchase", "pluginType": "FILE_WRITE", "configurationJson": "{\"workspaceRoot\":\".\",\"path\":\"supplier/rejected-purchase.txt\",\"content\":\"Purchase proposal ${variables.purchaseCaseId} was rejected during human review.\"}", "timeoutSeconds": 30, "maxRetries": 0, "joinCondition": "ALL_PARENTS", "xPosition": 1450, "yPosition": 480 }
  ],
  "dependencies": [
    { "parentTask": "downloadSupplierFeed", "childTask": "readSupplierFeed", "condition": "ON_SUCCESS", "expression": null },
    { "parentTask": "readSupplierFeed", "childTask": "parseSupplierFeed", "condition": "ON_SUCCESS", "expression": null },
    { "parentTask": "initializePurchase", "childTask": "reviewPurchase", "condition": "ON_SUCCESS", "expression": null },
    { "parentTask": "parseSupplierFeed", "childTask": "reviewPurchase", "condition": "ON_SUCCESS", "expression": null },
    { "parentTask": "scrapeSupplierCatalog", "childTask": "reviewPurchase", "condition": "ON_SUCCESS", "expression": null },
    { "parentTask": "inspectVendorDrop", "childTask": "reviewPurchase", "condition": "ON_SUCCESS", "expression": null },
    { "parentTask": "reviewPurchase", "childTask": "archiveApprovedFeed", "condition": "ON_SUCCESS", "expression": null },
    { "parentTask": "reviewPurchase", "childTask": "sendPurchaseNotice", "condition": "ON_SUCCESS", "expression": null },
    { "parentTask": "reviewPurchase", "childTask": "writeRejectedNote", "condition": "ON_FAILURE", "expression": null }
  ]
}
